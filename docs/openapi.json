  "info": {
    "title": "Chat Server API",
    "description": "聊天服务端 API 文档",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "用户名，仅字母、数字、下划线",
            "minLength": 3,
            "maxLength": 32,
            "example": "alice_dev"
          },
          "email": {
            "type": "string",
            "description": "邮箱",
            "maxLength": 255,
            "example": "alice@example.com"
          },
          "password": {
            "type": "string",
            "description": "密码，8-64 位且必须同时包含字母和数字",
            "minLength": 8,
            "maxLength": 64,
            "example": "Password123"
          },
          "nickname": {
            "type": "string",
            "description": "昵称",
            "maxLength": 64,
            "example": "Alice"
          },
          "avatar": {
            "type": "string",
            "description": "头像 URL",
            "maxLength": 512,
            "example": "https://example.com/avatar.png"
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "用户名或邮箱",
            "example": "alice_dev"
          },
          "password": {
            "type": "string",
            "description": "密码",
            "example": "Password123"
          },
          "deviceType": {
            "type": "string",
            "description": "设备类型",
            "enum": [
              "web",
              "mobile",
              "desktop",
              "other"
            ],
            "example": "web"
          },
          "deviceId": {
            "type": "string",
            "description": "设备唯一标识",
            "example": "browser-uuid-12345"
          }
        },
        "required": [
          "identifier",
          "password",
          "deviceType",
          "deviceId"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "刷新令牌",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6..."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ModelCatalogItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "模型全局唯一标识",
            "example": "deepseek-chat"
          },
          "label": {
            "type": "string",
            "description": "模型展示名称",
            "example": "DeepSeek Chat"
          },
          "provider": {
            "type": "string",
            "description": "模型归属供应商标识",
            "example": "deepseek"
          }
        },
        "required": [
          "id",
          "label",
          "provider"
        ]
      },
      "ChatRequestDto": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "description": "会话全局唯一标识。若为空则隐式创建新会话",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "modelId": {
            "type": "string",
            "description": "指定的模型唯一标识",
            "example": "deepseek-chat"
          },
          "content": {
            "type": "string",
            "description": "用户提问正文内容",
            "example": "请解释一下量子纠缠"
          },
          "attachmentIds": {
            "description": "随本次提问携带的附件 ID 列表",
            "example": [
              "123e4567-e89b-12d3-a456-426614174000"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "modelId",
          "content"
        ]
      },
      "CreateConversationDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "会话标题",
            "example": "关于 NestJS 的探讨"
          }
        }
      },
      "UpdateConversationDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "新的会话标题",
            "example": "重命名的会话"
          }
        },
        "required": [
          "title"
        ]
      }
    }
  }
}