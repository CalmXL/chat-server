# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=chat_server
DATABASE_SYNCHRONIZE=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (secrets must be at least 32 characters)
JWT_ACCESS_SECRET=change-me-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# AI Providers & Configuration
# Model catalog (providers + models) lives in config/ai-providers.json.
# Secrets stay here, referenced by name via each provider's apiKeyEnv.
# (AI_PROVIDERS_JSON remains supported as an inline override, e.g. in tests/CI.)
AI_PROVIDERS_FILE=./config/ai-providers.json
DEEPSEEK_API_KEY=sk-your-key
OPENCODE_GO_API_KEY=sk-your-opencode-go-key
AI_MAX_CONCURRENT_STREAMS=3
AI_RATE_LIMIT_RPM=20
AI_MAX_UPLOAD_MB=10
AI_HISTORY_WINDOW=20
AI_DOC_TRUNCATE_CHARS=2000
UPLOAD_DIR=./uploads
AI_SYSTEM_PROMPT=
