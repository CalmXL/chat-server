# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=chat_server
DATABASE_SYNCHRONIZE=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (secrets must be at least 32 characters)
JWT_ACCESS_SECRET=change-me-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# AI Providers & Configuration
AI_PROVIDERS_JSON=[{"id":"deepseek","baseURL":"https://api.deepseek.com/v1","apiKey":"sk-your-key","models":[{"id":"deepseek-chat","label":"DeepSeek Chat"},{"id":"deepseek-reasoner","label":"DeepSeek Reasoner"}]}]
AI_MAX_CONCURRENT_STREAMS=3
AI_RATE_LIMIT_RPM=20
AI_MAX_UPLOAD_MB=10
AI_HISTORY_WINDOW=20
AI_DOC_TRUNCATE_CHARS=2000
UPLOAD_DIR=./uploads
AI_SYSTEM_PROMPT=
